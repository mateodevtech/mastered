# Neon Postgres connection string (get from https://neon.tech after creating a project)
DATABASE_URL=

# Resend API key for magic-link emails (https://resend.com)
RESEND_API_KEY=

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Vercel Blob (photo proof uploads) — from Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# Secret shared with Vercel Cron so /api/cron/* can't be triggered publicly.
# Vercel sends it automatically as a Bearer token for configured cron jobs
# once set as a project env var. Generate any random string for local dev.
CRON_SECRET=

# Base URL used in emails for magic links. Mastered's dev server runs on
# port 3001 (fixed in package.json) to avoid clashing with port 3000.
APP_URL=http://localhost:3001
